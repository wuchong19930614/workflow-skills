{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "xinci-bench 方向记录",
  "description": "说明性 schema;强制校验在 ledger.py 与 validate_ledger.py。账本结构 {schema_version: 1, directions: {slug: 本记录}}。lane=bench 的记录按 required,lane=quick 的按 quick_required。",
  "type": "object",
  "required": ["slug", "title", "site_type", "lane", "state", "benchmarks", "clusters", "crowding", "paid", "model", "decision", "evidence_refs", "bindings", "history"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string"},
    "site_type": {"enum": ["tool", "content", "game", "mixed"]},
    "lane": {"enum": ["bench", "quick"]},
    "state": {"enum": ["found", "go", "rejected", "parked", "watching"], "description": "watching 只对 lane=quick 合法"},
    "benchmarks": {"type": "array", "minItems": 1, "items": {"required": ["domain", "registered_at", "aged_domain", "traffic_start", "authority_score", "us_organic_now", "us_organic_m12", "en_organic_now", "en_organic_m12", "covered_demand", "link_driven", "algo_risk", "monetization", "clean"]}},
    "clusters": {"type": "array", "items": {"required": ["id", "seed_term", "volume", "en_volume", "measured_at", "coverage", "near_me", "answered", "counted"]}},
    "crowding": {"type": ["integer", "null"], "minimum": 1},
    "paid": {"required": ["applicable", "price_month", "evidence"]},
    "model": {"type": ["object", "null"], "description": "bench_model.compute 的输出,结算时写入"},
    "decision": {"type": ["object", "null"], "required": ["verdict", "gate", "reason", "biggest_unknown", "scope_hit", "decided_at", "doc_sha256"]},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "bindings": {"type": ["object", "null"], "required": ["bound_at", "files"]},
    "history": {"type": "array", "minItems": 1},
    "object": {"required": ["name", "type", "first_public", "date_source"], "properties": {"type": {"enum": ["game", "other"]}}, "description": "快道:催生新词的对象;first_public 是第一次让大量普通用户用上的日期,游戏须在速判日前 0–14 天,其他 0–90 天"},
    "terms": {"type": "array", "minItems": 1, "items": {"required": ["term", "source", "first_seen"]}},
    "volume": {"type": ["object", "null"], "description": "快道:结算时由最新 quick_volume 写入(英文区合计 estimate_7d/30d、各国 by_geo 与 anchors、最早锚词测量日、trend_geo、trend)"},
    "serp": {"type": ["object", "null"], "description": "快道:结算时由最新 quick_screen 写入(aio_present、aio_completes、occupied_by)"},
    "watch": {"type": ["object", "null"], "required": ["since", "expires_at", "checks"]},
    "follow_up": {"type": ["object", "null"], "required": ["status", "go_at", "launch_by", "domain", "started_at", "launched_at", "reason"], "properties": {"status": {"enum": ["pending", "started", "launched", "abandoned"]}}},
    "basis": {"enum": ["forecast"], "description": "快道可选:按上线前预判登记的方向写 forecast;现行(速判)方向不写这个字段。开玩前(state=found)按预判结算,开玩后的复核按现行路径"},
    "forecast": {"type": ["object", "null"], "required": ["ref", "playable_at", "object_volume_pre", "tasks", "forecast_p25", "forecast_median", "review_at", "review", "slipped_days"], "description": "快道可选,仅预判方向开玩前结算为 go 或观察中时写:ref 是结算所依据的最新预判观察;playable_at 须等于 object.first_public;object_volume_pre 是对象名开玩前各国月搜索量;tasks 是 [{task, r_p25, r_median}](参照库倍数);forecast_p25、forecast_median 是站点预测月搜索量;review_at = 开玩日 + 7 天;review 是复核结果(复核前为 null);slipped_days 是开玩日累计推迟天数。此时 model 是 quick_model.forecast 的输出(basis=forecast),volume、serp 为 null;go 的 follow_up.launch_by = 开玩日前 1 天,观察中的 watch.expires_at = review_at"}
  },
  "quick_required": ["slug", "title", "site_type", "lane", "state", "object", "terms", "volume", "serp", "watch", "follow_up", "model", "decision", "evidence_refs", "bindings", "history"]
}
