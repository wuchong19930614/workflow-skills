{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "xinci-simple 观察文件（只记录不裁决）",
  "type": "object",
  "required": [
    "slug",
    "observed_at",
    "stage",
    "source_urls",
    "points"
  ],
  "properties": {
    "slug": {
      "type": "string"
    },
    "observed_at": {
      "type": "string",
      "description": "带时区 ISO"
    },
    "stage": {
      "enum": [
        "scan",
        "verify"
      ]
    },
    "semrush_preview": {
      "type": "object",
      "description": "scan 用：queried_at / filters / note",
      "properties": {
        "queried_at": {
          "type": "string"
        },
        "filters": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "browser_preflight": {
      "type": "object",
      "description": "verify 必填",
      "required": [
        "controllable",
        "desktop",
        "region",
        "logged_out",
        "evidence"
      ],
      "properties": {
        "controllable": {
          "type": "boolean"
        },
        "desktop": {
          "type": "boolean"
        },
        "region": {
          "enum": [
            "us",
            "other",
            "unknown"
          ]
        },
        "logged_out": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string"
        }
      }
    },
    "query_url": {
      "type": "string"
    },
    "ai_overview": {
      "type": "object",
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "completes_task": {
          "type": "boolean"
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "serp_top10": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pos",
          "domain",
          "type",
          "completes_task"
        ],
        "properties": {
          "pos": {
            "type": "integer"
          },
          "domain": {
            "type": "string"
          },
          "dr": {
            "type": [
              "number",
              "null"
            ]
          },
          "type": {
            "enum": [
              "tool",
              "article",
              "forum",
              "video",
              "official",
              "brand",
              "other"
            ]
          },
          "completes_task": {
            "type": "boolean"
          },
          "dated": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "fresh": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "format_match": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "maxItems": 10
    },
    "page2_note": {
      "type": "string"
    },
    "trends_12m": {
      "type": "string"
    },
    "scope_recheck": {
      "type": "object",
      "required": [
        "ymyl",
        "firsthand",
        "brand_nav",
        "news"
      ],
      "properties": {
        "ymyl": {
          "type": "boolean"
        },
        "firsthand": {
          "type": "boolean"
        },
        "brand_nav": {
          "type": "boolean"
        },
        "news": {
          "type": "boolean"
        }
      }
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema_version": {
      "const": 2
    },
    "direct_answer": {
      "type": "object",
      "properties": {
        "featured_snippet_completes_task": {
          "type": "boolean"
        },
        "native_widget_completes_task": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "featured_snippet_completes_task",
        "native_widget_completes_task",
        "evidence"
      ]
    },
    "serp_structure": {
      "type": "object",
      "properties": {
        "blocked": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "blocked",
        "evidence"
      ]
    },
    "trends": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "nonseasonal",
            "seasonal",
            "unknown"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "evidence",
        "source_url"
      ]
    },
    "scope_evidence": {
      "type": "string",
      "minLength": 1
    },
    "natural_results_exhausted": {
      "type": "boolean"
    },
    "exhaustion_evidence": {
      "type": "string",
      "minLength": 1
    },
    "task_group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "representative_keyword": {
          "type": "string",
          "minLength": 1
        },
        "form": {
          "enum": [
            "info",
            "lookup",
            "tool",
            "commercial",
            "mixed"
          ]
        },
        "niche": {
          "enum": [
            "tech",
            "home",
            "hobby"
          ]
        },
        "coverage_reason": {
          "type": "string",
          "minLength": 1
        },
        "exclusion_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "keywords",
        "representative_keyword",
        "form",
        "niche",
        "coverage_reason"
      ]
    },
    "prescreen": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object"
        }
      },
      "required": [
        "basis",
        "result"
      ]
    },
    "audit_basis": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "scan"
          }
        }
      },
      "then": {
        "required": [
          "semrush_preview"
        ]
      }
    },
    {
      "if": {
        "required": [
          "task_group"
        ]
      },
      "then": {
        "required": [
          "schema_version",
          "query_url"
        ]
      }
    }
  ],
  "$comment": "允许早期拒绝/支撑组剔除的部分观察；正式通过所需完整字段由 qualification.py 按用途强制检查。"
}
