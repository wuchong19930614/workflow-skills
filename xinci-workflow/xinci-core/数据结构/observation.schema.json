{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "xinci 观察记录(证据文件)",
  "description": "记录本次看到了什么，并把实际检查过的闸门结论绑定到来源；写要点不写转录。文件名约定:证据/<slug>/<YYYY-MM-DD>-<阶段>.json,阶段 ∈ scan/track/qualify/decide。",
  "type": "object",
  "required": ["slug", "observed_at", "stage", "points"],
  "properties": {
    "slug": { "type": "string", "description": "所属候选" },
    "observed_at": { "type": "string", "description": "观察时间 ISO 8601" },
    "stage": { "type": "string", "enum": ["scan", "track", "qualify", "decide"], "description": "产生本观察的阶段" },
    "source_urls": { "type": "array", "items": { "type": "string" }, "description": "本次实际打开过的页面;未打开的不得列入" },
    "points": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "要点式观察,每条一句话(如:SERP 首屏无原生组件;第 2 页出现完整题库竞品)"
    },
    "gates": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "本次涉及的闸门结论(G0–G8 → pass/veto;G3 另有第三种结论 veto_window_bet,见闸门契约 G3),仅列实际检查过的"
    },
    "g6_lines": {
      "type": "object",
      "required": ["subscription", "advertising"],
      "properties": {
        "subscription": { "type": "string", "enum": ["pass", "veto", "N/A"] },
        "advertising": { "type": "string", "enum": ["pass", "veto", "N/A"] }
      },
      "additionalProperties": false,
      "description": "正式 G6 的逐线结论。qualified 观察必填两项；lane=new 的 advertising 应为 N/A,mature 两项只能 pass/veto。算式、假设与出处写入 points/source_urls"
    },
    "g6_tentative_lines": {
      "type": "object",
      "required": ["subscription", "advertising"],
      "properties": {
        "subscription": { "type": "string", "enum": ["tentative_pass", "tentative_veto", "N/A"] },
        "advertising": { "type": "string", "enum": ["tentative_pass", "tentative_veto", "N/A"] }
      },
      "additionalProperties": false,
      "description": "窗口期 scan/track 观察的逐线暂定结论，仅供当期 G3 判断占位否决是否生效。它不是正式 G6，不得与 g6_lines 并存；lane=new 的 advertising 应为 N/A。依据写入 points/source_urls"
    },
    "income_score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "description": "正式认定的收入可行性维度得分；qualified 观察必填并与 transition 参数一致"
    },
    "window_bet": {
      "type": "object",
      "required": ["implementation_urls", "lag_sample_url", "lag_days", "rationale"],
      "properties": {
        "implementation_urls": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "format": "uri" },
          "description": "已实测可完成任务的免费实现"
        },
        "lag_sample_url": { "type": "string", "format": "uri", "description": "同一实现收录上一个同类对象的页面" },
        "lag_days": { "type": "integer", "minimum": 0, "description": "实测收录时差天数" },
        "rationale": { "type": "string", "minLength": 1, "description": "为何判断只是尚未收录而非结构上不可见" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "not": {
        "required": ["g6_lines", "g6_tentative_lines"]
      }
    },
    {
      "if": {
        "required": ["g6_tentative_lines"]
      },
      "then": {
        "properties": {
          "stage": { "enum": ["scan", "track"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": { "enum": ["scan", "track"] },
          "gates": { "required": ["G3"] }
        },
        "required": ["stage", "gates"]
      },
      "then": {
        "required": ["g6_tentative_lines"]
      }
    }
  ],
  "additionalProperties": false
}
