{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinci browser preflight",
  "type": "object",
  "required": ["schema_version", "run_id", "checked_at", "channel", "controllable", "desktop", "region", "logged_out", "g1_ready", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "checked_at": {"type": "string", "format": "date-time"},
    "channel": {"enum": ["chrome", "in-app"]},
    "controllable": {"type": "boolean"},
    "desktop": {"type": "boolean"},
    "region": {"enum": ["us", "other", "unknown"]},
    "logged_out": {"type": "boolean"},
    "g1_ready": {"type": "boolean"},
    "note": {"type": ["string", "null"]},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
