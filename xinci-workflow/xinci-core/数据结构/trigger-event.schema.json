{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Xinci trigger pool event",
  "type": "object",
  "required": ["trigger_id", "event", "at", "actor"],
  "properties": {
    "trigger_id": {"type": "string", "pattern": "^trigger-[a-f0-9]{16}$"},
    "event": {"enum": ["add", "approve", "discard"]},
    "at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "run_id": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "observed_date": {"type": "string", "format": "date"},
    "title": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "source_family": {"type": "string", "minLength": 1},
    "task_hypothesis": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "search_evidence_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "payer": {"type": "string", "minLength": 1},
    "repeat_unit": {"type": "string", "minLength": 1},
    "self_serve_path": {"type": "string", "minLength": 1},
    "base_case_source": {"type": "string", "format": "uri"},
    "reason": {"type": "string", "minLength": 1}
  },
  "dependentRequired": {"run_id": ["round"], "round": ["run_id"]},
  "additionalProperties": false
}
