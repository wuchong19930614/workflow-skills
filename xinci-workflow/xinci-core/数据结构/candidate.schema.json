{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "xinci 候选账本记录",
  "description": "数据极简原则:每个字段都必须服务于一次真实决策。裁决只在账本,时间只记录不调度。",
  "type": "object",
  "required": [
    "slug",
    "term",
    "state",
    "lane",
    "first_observed_at",
    "source",
    "task",
    "evidence_refs",
    "history"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "候选唯一标识,kebab-case"
    },
    "term": {
      "type": "string",
      "description": "精确观察措辞,禁止转述重构"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "竞争中的其他叫法(官方名 vs 社区昵称)"
    },
    "state": {
      "type": "string",
      "enum": [
        "captured",
        "screened",
        "tracking",
        "formation_confirmed",
        "qualified",
        "build_ready",
        "pilot_ready",
        "fast_grab_ready",
        "hold",
        "rejected",
        "expired",
        "superseded",
        "withdrawn",
        "built",
        "disqualified",
        "no_site"
      ],
      "description": "生命周期状态,仅 registrar 可写"
    },
    "lane": {
      "type": "string",
      "enum": [
        "new",
        "mature"
      ],
      "description": "赛道。new=新词道(措辞太新以致查无,Semrush 在窗口期禁用，advertising 线为 N/A);mature=成熟错价词道(有真实搜索量、SERP 被守得弱,不适用 new 道的 Semrush 禁令)。六条盈利线及各赛道适用性见闸门契约 G6"
    },
    "first_observed_at": {
      "type": "string",
      "description": "首次捕获时间,ISO 8601(事实记录)"
    },
    "last_checked_at": {
      "type": "string",
      "description": "最近复查时间,ISO 8601(事实记录,不用于调度)"
    },
    "expiry": {
      "type": [
        "string",
        "null"
      ],
      "description": "失效日 YYYY-MM-DD。captured 排队位表示还值得几天深审;screened 及后继表示窗口/形成失效日。captured→screened 时 registrar 强制用 --expiry 完成语义切换"
    },
    "source": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "首次捕获来源页面"
        },
        "note": {
          "type": "string",
          "description": "现场观察摘要,一句话"
        }
      }
    },
    "task": {
      "type": "string",
      "description": "搜索者想完成的具体任务"
    },
    "site_thesis": {
      "type": "string",
      "minLength": 1,
      "description": "为何该方向能形成独立站的一句话假设；新注册候选应尽早填写"
    },
    "task_families": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "description": "站点可拥有的独立任务家族，避免把单个关键词当成站点"
    },
    "origin": {
      "type": "string",
      "enum": ["signal", "trigger"],
      "description": "连续运行正式候选的入口来源"
    },
    "trigger_ref": {
      "type": "string",
      "pattern": "^trigger-[a-f0-9]{16}$",
      "description": "origin=trigger 时指向真实存在且未废弃的触发事件；pending 或 approved 均可，approved 时 term 须与已批准 query 归一化一致"
    },
    "window_estimate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "days",
        "weeks",
        "months",
        null
      ],
      "description": "窗口评估,推理写在证据里"
    },
    "play": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "fast_grab",
        "single_domain",
        "cluster_expansion",
        null
      ],
      "description": "决策时写入"
    },
    "gates": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "各闸门最近结论(G0–G8 → pass/veto,G3 另有第三种结论 veto_window_bet);完整证据在 evidence_refs"
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "description": "认定阶段 100 分制得分,未认定为 null"
    },
    "income_score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 20,
      "description": "认定阶段收入可行性维度得分。qualified 及其后继须为 1–20,用于阻止收入维度 0 分但总分仍过 80"
    },
    "g6_passed_lines": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "subscription",
          "lead_generation",
          "affiliate",
          "transaction",
          "paid_report",
          "advertising"
        ]
      },
      "description": "正式 G6 通过的盈利线。qualified 及其后继至少一项;lane=new 不得含 advertising"
    },
    "invalidation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "失效条件清单,命中即提议放弃"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "观察文件路径,相对已配置的数据区根目录"
    },
    "decision_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "决策书 md 路径;仅 go 决策携带"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "被取代时指向新候选 slug"
    },
    "recheck_after": {
      "type": [
        "string",
        "null"
      ],
      "description": "仅 G1/G2/G3 可逆 SERP 型否决的复核日期;不自动重开"
    },
    "history": {
      "type": "array",
      "description": "状态转移、复查登记与字段修订史,registrar 追加,不可改写;每条附当次提交的参数快照(顶层 gates/score 等字段会被后续转移覆盖,翻转史只在这里)",
      "items": {
        "type": "object",
        "required": [
          "at",
          "to",
          "by"
        ],
        "properties": {
          "at": {
            "type": "string",
            "description": "转移时间 ISO 8601"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "description": "原状态,注册时为 null"
          },
          "to": {
            "type": "string",
            "description": "新状态;amend/checked 条目 from==to"
          },
          "by": {
            "type": "string",
            "description": "执行的 skill 名"
          },
          "run_id": {
            "type": "string",
            "description": "连续运行写入时必填的可恢复运行会话 ID"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "description": "连续运行写入时必填的活动轮号,供 manifest 自动归集候选"
          },
          "reason": {
            "type": "string",
            "description": "拒绝/过期/搁置/修订等的决定性理由"
          },
          "amend": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "amend 条目专用:本次修订的字段名(expiry/aliases/invalidation/gates;gates 仅 captured 可补记)"
          },
          "checked": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "checked 条目专用:本次复查登记的观察文件路径"
          },
          "gates": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "快照:本次转移提交的闸门结论"
          },
          "window_estimate": {
            "type": "string",
            "description": "快照:本次提交的窗口评估"
          },
          "expiry": {
            "type": "string",
            "description": "快照:本次提交/修订的失效日"
          },
          "expiry_trigger": {
            "type": "string",
            "enum": [
              "date",
              "invalidation",
              "window_closed"
            ],
            "description": "转 expired 的机器可审计触发类型:到达失效日、命中失效条件、快道窗口关闭"
          },
          "invalidation": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "快照:本次提交的失效条件"
          },
          "score": {
            "type": "integer",
            "description": "快照:本次提交的认定分数"
          },
          "income_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "快照:本次提交的收入可行性维度得分"
          },
          "g6_passed_lines": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "subscription",
                "lead_generation",
                "affiliate",
                "transaction",
                "paid_report",
                "advertising"
              ]
            },
            "description": "快照:本次正式通过 G6 的盈利线"
          },
          "play": {
            "type": "string",
            "description": "快照:本次提交的打法"
          },
          "decision_ref": {
            "type": "string",
            "description": "快照:本次提交的决策书路径"
          },
          "superseded_by": {
            "type": "string",
            "description": "快照:本次提交的取代者 slug"
          },
          "reopened": {
            "type": "boolean",
            "description": "本条是否为基于新证据的受控重开"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "本次注册、转移、补记或重开直接使用的观察文件；用于把 gates 快照绑定到具体证据"
          },
          "add_aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "快照:amend 追加的别名"
          },
          "add_invalidation": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "快照:amend 追加的失效条件"
          }
        }
      }
    }
  }
}
